# Rootless Quadlet unit for Freezy Arena.
#
# Install as the user that runs the field server:
#   podman build -t localhost/freezy-arena:latest .
#   mkdir -p ~/.config/containers/systemd
#   cp deploy/freezy-arena.container ~/.config/containers/systemd/
#   systemctl --user daemon-reload
#   systemctl --user start freezy-arena
#
# The host network helper in deploy/host/ must be installed first; it creates /run/freezy-net.
#
# Host networking is required: the server binds the driver-station listener to 10.0.100.5 and talks
# to robots, the access point, the switch and the PLC directly on the field VLANs.

[Unit]
Description=Freezy Arena (rootless container)
# Keep trying: a field server that gives up on the arena after a few quick failures stays down until
# someone logs in.
StartLimitIntervalSec=0

[Container]
ContainerName=freezy-arena
Image=localhost/freezy-arena:latest
Network=host
# `z` puts the shared container label on everything in the volume at each start, so a file left with
# another container's private label cannot stop the arena from starting.
Volume=freezy-arena-data:/data:z
# Spool shared with the root-owned host network helper (deploy/host/). The arena writes requests and
# reads results; it has no other way to change the host's network.
Volume=/run/freezy-net/request:/run/freezy-net/request:z
Volume=/run/freezy-net/result:/run/freezy-net/result:ro
Timezone=local

[Service]
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
