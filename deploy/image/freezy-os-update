#!/usr/bin/python3
"""Update the field server's image, or go back to the one before. Run as root.

    freezy-os-update                  fetch the newest build of this server's image and stage it
    freezy-os-update --image REF      move to another image (a registry reference)
    freezy-os-update --image REF --transport oci    ... carried in on a disk (any transport bootc takes)
    freezy-os-update --rollback       go back to the image this server ran before
    freezy-os-update --check          only say whether an update may start now (exit 0 yes, 1 no)

    --apply   restart straight away; without it the change takes effect at the next restart
    --force   go ahead even while a match is running

It refuses while a match is running or its results are not committed yet, the rule deploy/freezy-update
keeps for the arena alone. Anything else that updates the server (a fleet manager, for one) can ask
`freezy-os-update --check` first.

The image carries the operating system, the host pieces, the arena and Kea, so all of them change
together. A new image that fails its boot check (/usr/lib/greenboot/check/required.d/50-freezy.sh) goes
back to the one before on its own.

Set FREEZY_ADMIN_PASSWORD if the arena has an admin password.
"""
import argparse
import importlib.machinery
import importlib.util
import os
import subprocess
import sys

ARENA_TOOLS = os.environ.get("FREEZY_UPDATE_TOOL", "/usr/libexec/freezy-update")
PRE_MATCH = 0


class Stop(Exception):
    """A reason to stop. Nothing has been changed."""


def say(message):
    print(message, flush=True)
    subprocess.run(["logger", "-t", "freezy-os-update", "--", message], check=False,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def arena_client():
    """The arena's match play client, from freezy-update, which already speaks to it."""
    loader = importlib.machinery.SourceFileLoader("freezy_update", ARENA_TOOLS)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader("freezy_update", loader))
    loader.exec_module(module)
    return module.Arena("127.0.0.1", password=os.environ.get("FREEZY_ADMIN_PASSWORD"))


def hold(arena, force):
    """Stop if a match is under way. An arena that does not answer holds nothing: it may be the reason
    for the update."""
    try:
        status = arena.status()
    except OSError as error:
        say(f"The arena is not answering ({error}); no match can be running.")
        return
    say(f"Loaded: {status['name']} (match state {status['state']}).")
    if status["state"] == PRE_MATCH:
        return
    if not force:
        raise Stop("A match is running or its results are not committed yet. Finish it first, or use "
                   "--force. Nothing was changed.")
    say("Going ahead during a match because of --force.")


def commands(image=None, rollback=False, apply=False, transport=None):
    """The commands that make the change, in order."""
    if rollback:
        steps = [["bootc", "rollback"]]
    elif image:
        steps = [["bootc", "switch"] + (["--transport", transport] if transport else []) + [image]]
    else:
        steps = [["bootc", "upgrade"]]
    if apply:
        steps.append(["systemctl", "reboot"])
    return steps


def main(argv=None, arena=None, run=subprocess.call):
    parser = argparse.ArgumentParser(description="Update the field server's image, or go back.")
    choice = parser.add_mutually_exclusive_group()
    choice.add_argument("--image", metavar="REF", help="move to this image")
    choice.add_argument("--rollback", action="store_true", help="go back to the image before")
    choice.add_argument("--check", action="store_true", help="only say whether an update may start now")
    parser.add_argument("--transport", help="how --image is reached when it is not in a registry")
    parser.add_argument("--apply", action="store_true", help="restart straight away")
    parser.add_argument("--force", action="store_true", help="go ahead even while a match is running")
    args = parser.parse_args(argv)
    try:
        hold(arena or arena_client(), args.force)
        if args.check:
            say("An update may start now.")
            return 0
        for command in commands(args.image, args.rollback, args.apply, args.transport):
            if run(command) != 0:
                raise Stop(f"`{' '.join(command)}` failed. The server is still on the image it was running.")
        if not args.apply:
            say("Staged. It takes effect at the next restart; nothing changes until then.")
    except Stop as stop:
        say(str(stop))
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
